# Chrome extension ID (chrome://extensions → Banchor → ID). Lets the dashboard talk to the extension.
NEXT_PUBLIC_EXTENSION_ID=
# Backend (Railway/Render). Optional: portfolio, roast and live pages read from it.
NEXT_PUBLIC_BACKEND_URL=https://backend-production-1dd0.up.railway.app
# Monad testnet RPC
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Optional override of lib/addresses.json (copy of backend/addresses.json), one line of JSON
NEXT_PUBLIC_ADDRESSES={}
