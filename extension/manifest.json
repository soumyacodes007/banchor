{
  "manifest_version": 3,
  "name": "Doomscroll Dividends",
  "version": "0.2.0",
  "description": "Turns your scrolling and anything you highlight into mock xStock buys on Monad testnet.",
  "permissions": ["tabs", "alarms", "idle", "storage", "contextMenus"],
  "host_permissions": [
    "https://testnet-rpc.monad.xyz/*",
    "https://rpc.ankr.com/*",
    "https://rpc-testnet.monadinfra.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Doomscroll Dividends" },
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://www.youtube.com/*"],
      "js": ["live.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["highlight.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": ["https://*.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"]
  }
}
